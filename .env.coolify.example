POSTGRES_DB=globalgo_credit
POSTGRES_USER=globalgo
POSTGRES_PASSWORD=change_me

# Optional when frontend and API are served on different domains.
# If frontend proxies /api to backend through nginx, leave this empty.
VITE_API_BASE_URL=

# Use your frontend public URL if API is called directly from browser.
# Example: https://globalgo.tudominio.com
CORS_ALLOWED_ORIGIN=
